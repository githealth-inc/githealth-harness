{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitHealth Execution Economics v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trace_id",
    "currency",
    "input_tokens",
    "output_tokens",
    "estimated_total_cost"
  ],
  "properties": {
    "trace_id": {
      "type": "string"
    },
    "goal_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "currency": {
      "const": "USD"
    },
    "input_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "output_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "tool_calls": {
      "type": "integer",
      "minimum": 0
    },
    "execution_ms": {
      "type": "integer",
      "minimum": 0
    },
    "estimated_model_cost": {
      "type": "number",
      "minimum": 0
    },
    "estimated_tool_cost": {
      "type": "number",
      "minimum": 0
    },
    "estimated_total_cost": {
      "type": "number",
      "minimum": 0
    },
    "pricing_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "outcome_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
