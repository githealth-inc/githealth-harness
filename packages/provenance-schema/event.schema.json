{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitHealth Provenance Event v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "trace_id",
    "event_type",
    "occurred_at",
    "actor_ref",
    "result"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "trace_id": {
      "type": "string"
    },
    "parent_event_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_type": {
      "enum": [
        "proposal",
        "ontology_validation",
        "policy_decision",
        "approval",
        "execution",
        "outcome",
        "cost"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor_ref": {
      "type": "string"
    },
    "agent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "agent_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "protocol_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority_decision_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "action_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "result": {
      "type": "string"
    },
    "payload_digest": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional content digest; not proof of clinical correctness"
    }
  }
}
